# Public site URL (used for canonical links, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://muscateducation.com

# WhatsApp number that receives inquiries (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=96895775701

# --- Email delivery of inquiries (https://resend.com, free tier) ---
RESEND_API_KEY=
# Address that receives inquiries
INQUIRY_TO_EMAIL=info@muscateducation.com
# Sender address — must be on a domain you verified in Resend
INQUIRY_FROM_EMAIL=MHEC Website <website@muscateducation.com>

# --- Optional: keep a log of every inquiry in Supabase (free Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: blog editor on the live site via GitHub (Keystatic) ---
# Leave empty to edit blogs locally (npm run dev, then open /keystatic) and push to GitHub.
# Set to "owner/repo" to edit blogs on the live site; Keystatic will guide you through creating the GitHub app.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
